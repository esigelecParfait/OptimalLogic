      "borderSubtle": "rgb(22 22 22 / 0.08)",
      "action": "{primitive.color.accent.600}",
      "actionHover": "{primitive.color.accent.700}",
      "actionContrast": "{primitive.color.white}",
      "focus": "{primitive.color.accent.500}",
