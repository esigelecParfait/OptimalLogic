      "text": "{primitive.layout.container.text}",
      "content": "{primitive.layout.container.content}",
      "wide": "{primitive.layout.container.wide}"
    },
    "gutter": {
      "mobile": "{primitive.layout.gutter.mobile}",
      "tablet": "{primitive.layout.gutter.tablet}",
      "desktop": "{primitive.layout.gutter.desktop}"
    },
