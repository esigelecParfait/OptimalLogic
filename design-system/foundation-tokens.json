      "instant": "{primitive.motion.duration.instant}",
      "fast": "{primitive.motion.duration.fast}",
      "interactive": "{primitive.motion.duration.normal}",
      "entrance": "{primitive.motion.duration.slow}",
      "entranceStrong": "{primitive.motion.duration.xslow}",
      "ease": "{primitive.motion.ease.emphasized}",
